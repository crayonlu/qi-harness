{
  "name": "@crayonlu/qi-harness",
  "version": "1.0.0",
  "description": "Production omnibus Pi extension: plan/build, goal, subagents, MCP, ask/todo/btw, cleanup, slash categories, bash-bg, rewind, LSP, split diff.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "crayonlu",
    "url": "https://github.com/crayonlu"
  },
  "homepage": "https://github.com/crayonlu/qi-harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crayonlu/qi-harness.git",
    "directory": "packages/qi-harness"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "harness",
    "qi-harness"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./node_modules/pi-mcp-adapter/index.ts",
      "./node_modules/@narumitw/pi-lsp/src/index.ts",
      "./node_modules/@narumitw/pi-plan-mode/src/index.ts",
      "./node_modules/@narumitw/pi-goal/src/index.ts",
      "./node_modules/@narumitw/pi-statusline/src/index.ts",
      "./node_modules/@narumitw/pi-retry/src/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/@juicesharp/rpiv-todo/index.ts",
      "./node_modules/@juicesharp/rpiv-btw/index.ts",
      "./node_modules/pi-subagents/index.ts",
      "./node_modules/@crayonlu/qi-cleanup/extensions/cleanup.ts",
      "./node_modules/@crayonlu/qi-bash-bg/src/index.ts",
      "./node_modules/@crayonlu/qi-rewind/src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir test"
  },
  "dependencies": {
    "@crayonlu/qi-bash-bg": "1.0.0",
    "@crayonlu/qi-cleanup": "1.0.0",
    "@crayonlu/qi-rewind": "1.0.0",
    "@juicesharp/rpiv-ask-user-question": "2.1.0",
    "@juicesharp/rpiv-btw": "2.1.0",
    "@juicesharp/rpiv-todo": "2.1.0",
    "@narumitw/pi-goal": "0.28.0",
    "@narumitw/pi-lsp": "0.29.0",
    "@narumitw/pi-plan-mode": "0.28.0",
    "@narumitw/pi-retry": "0.28.0",
    "@narumitw/pi-statusline": "0.28.0",
    "pi-mcp-adapter": "2.13.0",
    "pi-subagents": "0.36.0"
  },
  "bundledDependencies": [
    "@crayonlu/qi-bash-bg",
    "@crayonlu/qi-cleanup",
    "@crayonlu/qi-rewind",
    "@juicesharp/rpiv-ask-user-question",
    "@juicesharp/rpiv-btw",
    "@juicesharp/rpiv-todo",
    "@narumitw/pi-goal",
    "@narumitw/pi-lsp",
    "@narumitw/pi-plan-mode",
    "@narumitw/pi-retry",
    "@narumitw/pi-statusline",
    "pi-mcp-adapter",
    "pi-subagents"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "typebox": "1.3.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "bundleDependencies": [
    "@crayonlu/qi-bash-bg",
    "@crayonlu/qi-cleanup",
    "@crayonlu/qi-rewind",
    "@juicesharp/rpiv-ask-user-question",
    "@juicesharp/rpiv-btw",
    "@juicesharp/rpiv-todo",
    "@narumitw/pi-goal",
    "@narumitw/pi-lsp",
    "@narumitw/pi-plan-mode",
    "@narumitw/pi-retry",
    "@narumitw/pi-statusline",
    "pi-mcp-adapter",
    "pi-subagents"
  ]
}
